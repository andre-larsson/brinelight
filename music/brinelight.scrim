# into a Dark Water fight: a shrimp snap and a low cave roll
pattern lurch tempo=96 beats=4 steps=4
harmony | E7 |
snap    | X... .... ..x. X... |
tom     | .... .... X..x ..XX |
glint   | .:12 [*]!:4 |
bass    | E2:8 ~B1:8 |

# into the Dark Watch: her own hand-bell and the watch glass out of the dark
pattern her_bell tempo=76 beats=2 steps=3
harmony | Am |
knell   | A3!!:6 |
tick    | X.. x.x |
timp    | A2!:6 |
gong    | X..... |

# ============================================================= arrangement
cue title
play t_in
loop theme_a theme_b theme_a2 interlude
beds sea wind

cue reach
play r_in
loop r1 {r2 r3c} r4 {r3 r3c}
beds sea wind deep

cue cove
play c_in
loop {c1 c1b} c2 c3 c4
beds sea=0.45

cue fog
play fg_in
loop {fg1 fg1b} {fg2 fg2b} fg3
beds sea=0.35 wind=0.9

cue fight
loop f1 f2 f3 {f2 f4}
beds sea=0.5 deep

cue murk
play m_in
loop m1 m2 {m3 m3b} m4
beds sea=0.2 deep

cue dread
loop d1 d2 {d1 f3}
beds sea=0.4 deep

cue pin
loop p1 p2
beds sea=0.4 deep

cue pin2
loop q1 q2
beds sea=0.3 deep

cue buoy
play bu_in
loop {bu1 bu1b} {bu2 bu2b} bu3 bu4
beds sea=0.6 deep

cue watch
play w_in
loop w1 w2 w3 w4
beds sea=0.35 deep

cue haul
play hl_in
loop hl1 hl2 {hl3 hl3b}
beds sea=0.6 wind deep=0.4

cue home
play dawn
loop morning
beds sea wind=0.6

cue fallen
play sink
loop ember
beds sea=1.2 deep

switch *   -> title  at bar  fade 2
switch *   -> reach  at bar  fade 2.5
switch *   -> cove   at bar  fade 2.5
switch *   -> fog    at bar  fade 2.5
switch *   -> fight  at bar  via strike   fade 0.8
switch *   -> murk   at bar  via lurch    fade 0.8
switch *   -> dread  at bar  via strike   fade 0.8
switch *   -> pin    at bar  via strike   fade 1
switch pin -> pin2   at bar  via crack    fade 0.5
switch *   -> buoy   at bar  via clang    fade 1
switch *   -> watch  at bar  via her_bell fade 1
switch *   -> haul   at bar  fade 2
switch *   -> home   at bar  fade 2
switch *   -> fallen at beat fade 1.5
