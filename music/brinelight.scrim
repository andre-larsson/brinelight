# ============================================================= the Tolling Buoy: Dark Water's pin
# 6/8 at 52 in A minor, rocking on a swell over a low A. The iron bell strikes on the swing, with the
# great bell (toll) when the depth brings it in. The singer in the cage sings the bell's own notes
# (A, C and E) and the sigh from E up to F. Each pass the chain slips (the bass falls by half steps
# under the bell's A) into the Wild Peal, and a breaking wave smothers it.
pattern bu_in tempo=52 beats=2 steps=3
harmony | Am | % | F/A | Esus4 E |
bass    | A1:6 | = | A1:6 | E2:4 B1:2 |
pad     | [*]?:6 | % | % | % |
toll    | A3:6 | _ | _ | _ |
iron    | _ | A3:6 | _ | _ |
singer  | _ | .:3 A4?:3 | -:3 ~C5:3 | B4:3 ~G#4:3 |

# the rocking toll: louder on each swing out, and now and then on the swing back
pattern bu1 tempo=52 beats=2 steps=3
harmony | Am | F/A | Am | F/A | Dm/A | Am | F/A | Esus4 E |
bass    | A1:4 E2:2 | A1:4 F2:2 | A1:4 E2:2 | A1:4 F2:2 |
bass    | A1:4 D2:2 | A1:4 E2:2 | A1:4 F2:2 | E2:4 B1:2 |
pad     | [*]?:6 | % | % | % | % | % | % | % |
horn    | E4?:6 | F4?:6 | E4?:6 | F4?:6 | F4:6 | E4:6 | F4:6 | E4?:6 |
iron    | A3?:6 | .:3 {A3 . .}??:3 | A3:6 | .:3 {A3 .}?:3 |
iron    | A3!:6 | .:3 {A3 .}?:3 | A3!:6 | {A3 .}?:3 .:3 |
toll    | A3:6 | _ | _ | _ | A3:6 | _ | _ | _ |
choir   | [*]?:6 | % | % | % | % | % | % | % |

# the same, and the singer hums the bell's note after it, and her beads glint
pattern bu1b from bu1
singer  | .:3 {A4 .}?:3 | _ | .:3 {C5 A4 .}?:3 | _ | .:3 {A4 D5 .}?:3 | _ | .:3 {C5 A4 .}?:3 | _ |
pluck   | .:2 {A5 C6 E6}:4 | .:6 | .:6 | .:2 {A5 C6 F6}:4 | .:2 {A5 D6 F6}:4 | .:6 | .:2 {A5 C6 F6 .}:4 | .:6 |

# the singer sings what the bell rings
pattern bu2 tempo=52 beats=2 steps=3
harmony | Am | F/A | Dm/A | Am | F | Dm | Bm7b5 | Esus4 E |
