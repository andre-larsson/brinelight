# ============================================================= one-bar bridges
# into any fight: the bell strikes and the drums answer
pattern strike tempo=80 beats=2 steps=3
key     D minor
harmony | A7 |
knell   | A3!:6 |
tom     | X..xXX |
pizz    | .:3 A2 C#3 E3 |

# a pin's second phase: the bell cracks
pattern crack tempo=96 beats=2 steps=3
key     D minor
harmony | A7 |
knell   | A3!!:6 |
gong    | X..... |
timp    | A2? A2 A2 A2! A2!! A2!! |
tom     | ...xXX |

# ============================================================= the end of an expedition
# the Lantern Heart rises: the song in A major, at dawn
pattern dawn tempo=60
key     A major
harmony | A | C#m | Bm | E | D | Bm | E7 | A |
flute   | A4:3 B4 C#5:2 | E5:4 D5:2 | D5:2 C#5:2 B4:2 | B4:6 |
flute   | A4:3 B4 C#5:2 | F#5:4 E5:2 | D5:2 C#5:2 B4:2 | A4:6 |
horn    | C#4:6 | E4:6 | D4:6 | B3:6 | A3:6 | D4:6 | D4:6 | C#4:6 |
harp    | [*]:6 | % | % | % | % | % | % | % |
pad     | [*]:6 | % | % | % | % | % | % | % |
bass    | A1:4 E2:2 | C#2:4 G#1:2 | B1:4 F#2:2 | E2:4 B1:2 |
bass    | D2:4 A1:2 | B1:4 F#2:2 | E2:4 B1:2 | A1:6 |
toll    | A3:6 | _ | _ | _ | A3:6 | _ | _ | _ |
choir   | [*]?:6 | % | % | % | % | % | % | % |

# the morning after: the light turning over the town
pattern morning tempo=60
key     A major
harmony | A | % | D | % | F#m | % | Esus4 | E |
lyre    | [*]:6 | % | % | % | % | % | % | % |
pad     | [*]?:6 | % | % | % | % | % | % | % |
bass    | A1:6 | = | D2:6 | = | F#1:6 | = | E2:6 | = |
pluck   | {chord}:2 .:4 | .:2 {chord}:4 | {chord}:2 .:4 | .:6 | {chord}:2 .:4 | .:2 {chord}:4 | {chord}:2 .:4 | .:6 |
toll    | A3:6 | _ | _ | _ | A3:6 | _ | _ | _ |
choir   | [*]?:6 | % | % | % | % | % | % | % |

# the tide takes you: the song's second line, falling, then only the ember
pattern sink tempo=54
harmony | Am | Fmaj7 | Dm | Esus4 E | Fmaj7 | Am |
flute   | E5:4 D5:2 | C5:4 A4:2 | F4:4 E4 D4 | E4:6 | .:6 | .:6 |
pad     | [*]?:6 | % | % | % | % | % |
bass    | A1:6 | F1:6 | D2:6 | E2:6 | F1:6 | A1:6 |
pluck   | _ | _ | _ | _ | .:2 {A5 C6 E6}:4 | .:6 |
toll    | _ | _ | _ | _ | A3:6 | _ |

pattern ember tempo=54
harmony | Am | % | Fmaj7 | % |
pad     | [*]?:6 | % | % | % |
bass    | A1:6 | = | F1:6 | = |
pluck   | .:2 {A5 E6 .}:4 | .:6 | .:2 {A5 C6 E6 .}:4 | .:6 |
toll    | A3:6 | _ | _ | _ |
choir   | [*]?:6 | % | % | % |

# ============================================================= arrangement
cue title
play t_in
loop theme_a theme_b theme_a2 interlude
beds sea wind

cue reach
play r_in
loop r1 {r2 r3c} r4 {r3 r3c}
beds sea wind deep

cue fight
loop f1 f2 f3 {f2 f4}
beds sea=0.5 deep

cue dread
loop d1 d2 {d1 f3}
beds sea=0.4 deep

cue pin
loop p1 p2
beds sea=0.4 deep

cue pin2
loop q1 q2
beds sea=0.3 deep

cue home
play dawn
loop morning
beds sea wind=0.6

cue fallen
play sink
loop ember
beds sea=1.2 deep

switch *   -> title  at bar  fade 2
switch *   -> reach  at bar  fade 2.5
switch *   -> fight  at bar  via strike  fade 0.8
switch *   -> dread  at bar  via strike  fade 0.8
switch *   -> pin    at bar  via strike  fade 1
switch pin -> pin2   at bar  via crack   fade 0.5
switch *   -> home   at bar  fade 2
switch *   -> fallen at beat fade 1.5
