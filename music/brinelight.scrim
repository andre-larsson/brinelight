title    Brinelight
about    Wren's music: a keeper's song over the sea that darkens the deeper she goes. Intensity is the depth: 0 the Shallows, 1 Dark Water (a far bell and a low drone), 2 the Belfry (a choir).
tempo    66
beats    3
steps    2        # 3/4 in eighth notes, 6 steps a bar. The fights are in 6/8, also 6 steps a bar
reverb   0.45
key      A minor

# Cues and the screens that play them:
#   title   the title screen, the opening pictures, the Workshop and Story so far
#   reach   the map, rewards, rests, Barnaby's, Fog events, treasure, a broken pin
#   fight   an ordinary fight          dread   a Dread (elite)
#   pin     a pin (boss)               pin2    a pin's second phase
#   home    the Lantern Heart rises    fallen  the tide takes you
# Intensity = depth: setIntensity(0) in the Shallows, 1 in Dark Water, 2 in the Belfry.
# Layer 1 adds the far bell (toll) and the drone bed; layer 2 adds the choir.

bed   sea     sea       vol=0.7  swell=9
bed   wind    wind      vol=0.22 pan=-0.3
bed   deep    drone     vol=0.32 note=A1 layer=1

# the keeper's song. Pans spread the parts so ones in the same range don't sit on top of each
# other: flute left and clarinet right, harp right and lyre left, the celesta wide right
voice flute   flute     vol=0.85 pan=-0.25 rev=0.45
voice clar    clarinet  vol=0.7  pan=0.3   rev=0.4
voice harp    harp      vol=0.45 pan=0.4   center=A3 arp=updown span=2 rev=0.4
voice lyre    harp      vol=0.42 pan=-0.4  center=A3 arp=updown rate=2 span=2 chance=0.85 jitter=0.04 rev=0.5
voice pad     strings   vol=0.3  pan=-0.1  center=C4 att=1.2 rel=2.5   # low enough to fill the gap above the bass
voice bass    fretless  vol=0.62
voice pluck   celesta   vol=0.32 pan=0.45  center=A5 chance=0.6 jitter=0.15 rev=0.6
# the deep: these join every cue once the depth reaches them
voice toll    bell      vol=0.38 pan=-0.5  rev=0.7 layer=1
voice choir   choir     vol=0.26 center=A3 att=1.5 rel=3 layer=2
# fights: fiddle left and pizzicato right; the low drums stay near the middle
voice pizz    pizz      vol=0.55 pan=0.4
voice fiddle  fiddle    vol=0.68 pan=-0.35 rev=0.3
voice horn    horn      vol=0.42 pan=0.25  center=D4 att=0.3
voice bodhran bodhran   vol=0.55 pan=-0.2
voice tom     tomlo     vol=0.5  pan=0.25
voice timp    timpani   vol=0.6
voice knell   bell      vol=0.5  pan=-0.15 rev=0.6
voice gong    gong      vol=0.4  pan=0.2
voice brass   brass     vol=0.45 pan=0.1   center=F4 gate=0.7

# eq: a cut at the pitch of each low drum, where it would boom on top of the bass, and a little
# air on the whole mix
eq mix     highshelf=8k,+2
eq bodhran peak=80,-6,1.4
eq tom     peak=95,-6,1.4
eq timp    peak=75,-4,1.5      # the timpani doubles the bass's D2 in the pins

# ============================================================= title: the keeper's song
pattern t_in
harmony | Am | Fmaj7 | Dm7 | E7 |
harp    | [*]:6 | % | % | % |
pad     | [*]?:6 | % | % | % |
bass    | A1:6 | F1:6 | D2:6 | E2:6 |

pattern theme_a
harmony | Am | C | G | Em | F | Dm | E7 | Am |
flute   | A4:3 B4 C5:2 | E5:4 D5:2 | D5:2 C5:2 B4:2 | B4:6 |
flute   | A4:3 B4 C5:2 | F5:4 E5:2 | D5:2 C5:2 B4:2 | A4:4 E4:2 |
harp    | [*]:6 | % | % | % | % | % | % | % |
pad     | [*]?:6 | % | % | % | % | % | % | % |
bass    | A1:4 E2:2 | C2:4 G2:2 | G1:4 D2:2 | E2:4 B1:2 |
bass    | F1:4 C2:2 | D2:4 A1:2 | E2:4 B1:2 | A1:4 E2:2 |

pattern theme_b
harmony | F | G | Am | Em | F | C/E | Dm | E7 |
flute   | C5:2 F5:2 A5:2 | G5:4 F5:2 | E5:2 C5:2 A4:2 | B4:4 G4:2 |
flute   | A4:2 C5:2 F5:2 | E5:4 G5:2 | F5:2 E5:2 D5:2 | B4:4 G#4:2 |
clar    | A3:6 | B3:6 | C4:6 | B3:6 | A3:6 | G3:6 | F3:6 | G#3:6 |
harp    | [*]:6 | % | % | % | % | % | % | % |
pad     | [*]?:6 | % | % | % | % | % | % | % |
bass    | F1:4 C2:2 | G1:4 D2:2 | A1:4 E2:2 | E2:4 B1:2 |
bass    | F1:4 C2:2 | E2:4 C2:2 | D2:4 A1:2 | E2:4 G#1:2 |

# the song again, low on the clarinet, with sparser harp
pattern theme_a2 from theme_a
mute    flute
mute    harp
clar    | A3:3 B3 C4:2 | E4:4 D4:2 | D4:2 C4:2 B3:2 | B3:6 |
clar    | A3:3 B3 C4:2 | F4:4 E4:2 | D4:2 C4:2 B3:2 | A3:4 E3:2 |
lyre    | [*]:6 | % | % | % | % | % | % | % |
pluck   | .:2 {chord}:4 | .:6 | .:2 {chord}:4 | .:6 | .:2 {chord}:4 | .:6 | .:2 {chord}:4 | .:6 |

pattern interlude
harmony | Fmaj7 | G | Am | E7 |
lyre    | [*]:6 | % | % | % |
pad     | [*]?:6 | % | % | % |
bass    | F1:6 | G1:6 | A1:6 | E2:6 |
pluck   | {chord}:2 .:2 {chord}:2 | % | % | % |

# ============================================================= reach: the map and the quiet screens
# a breath after a fight, leading into the A minor of r1
pattern r_in
harmony | Fmaj7 | Esus4 E |
pad     | [*]?:6 | % |
bass    | F1:6 | E2:6 |
pluck   | .:2 {A5 C6 E6}:4 | .:6 |

pattern r1
harmony | Am | % | Fmaj7 | % | C | % | G | Esus4 E |
lyre    | [*]:6 | % | % | % | % | % | % | % |
pad     | [*]?:6 | % | % | % | % | % | % | % |
bass    | A1:6 | = | F1:6 | = | C2:6 | = | G1:6 | E2:6 |
pluck   | {A5 C6 D6 E6 G5}:2 .:2 {A5 C6 D6 E6 G5}:2 | .:6 | {A5 C6 E6 G5}:2 .:2 {A5 C6 E6 G5}:2 | .:6 |
pluck   | {C6 D6 E6 G5}:2 .:2 {C6 D6 E6 G5}:2 | .:6 | {chord}:2 .:2 {chord}:2 | .:6 |
toll    | A3:6 | _ | _ | _ | C4:6 | _ | _ | _ |
choir   | [*]?:6 | % | % | % | % | % | % | % |

# Wren hums the first line of the song
pattern r2 from r1
mute    pluck
flute   | A4?:3 B4? C5?:2 | E5?:4 D5?:2 | C5?:6 | .:6 |
flute   | E4?:3 G4? C5?:2 | E5?:4 D5?:2 | D5?:2 C5?:2 B4?:2 | B4?:6 |

pattern r3
harmony | Dm7 | % | Am | % | Fmaj7 | % | Em7 | E7 |
lyre    | [*]:6 | % | % | % | % | % | % | % |
pad     | [*]?:6 | % | % | % | % | % | % | % |
bass    | D2:6 | = | A1:6 | = | F1:6 | = | E2:6 | = |
pluck   | {D6 E6 F5 A5 C6}:2 .:4 | .:2 {D6 E6 F5 A5 C6}:4 | {A5 C6 D6 E6 G5}:2 .:4 | .:6 |
pluck   | {A5 C6 E6 G5}:2 .:4 | .:2 {A5 C6 E6 G5}:4 | {E6 G5 B5 D6}:2 .:4 | .:2 {chord}:4 |
toll    | D4:6 | _ | _ | _ | A3:6 | _ | _ | _ |
choir   | [*]?:6 | % | % | % | % | % | % | % |

# r3 with a low clarinet line
pattern r3c from r3
clar    | A3?:3 C4? D4?:2 | F4?:4 E4?:2 | E4?:6 | .:6 |
clar    | C4?:3 D4? E4?:2 | A4?:4 G4?:2 | E4?:2 D4?:2 B3?:2 | B3?:6 |

# almost nothing: the sea, a chord, a glint
pattern r4
harmony | Fmaj7 | % | Am | Esus4 E |
pad     | [*]?:6 | % | % | % |
bass    | F1:6 | = | A1:6 | E2:6 |
pluck   | .:2 {A5 C6 E6 G5}:4 | .:6 | {A5 C6 E6}:6 | .:6 |
toll    | _ | _ | A3:6 | _ |
choir   | [*]?:6 | % | % | % |

# ============================================================= fights: 6/8 in D minor
# the waves under a fight: rolling pizzicato, bass and bodhran
pattern f1 tempo=80 beats=2 steps=3
key     D minor
harmony | Dm | % | Bb | C | Dm | % | Gm | A7 |
pizz    | D3 A3 D4 A3 F3 A3 | % | Bb2 F3 Bb3 F3 D3 F3 | C3 G3 C4 G3 E3 G3 |
pizz    | D3 A3 D4 A3 F3 A3 | % | G2 D3 G3 D3 Bb2 D3 | A2 E3 A3 E3 C#3 E3 |
bass    | D2:6 | D2:3 A1:3 | Bb1:6 | C2:6 | D2:6 | D2:3 A1:3 | G1:6 | A1:6 |
bodhran | X.o x.o | % | % | % | % | % | % | X.x xxx |
toll    | A3:6 | _ | _ | _ | A3:6 | _ | _ | _ |
choir   | [*]?:6 | % | % | % | % | % | % | % |

