title    Harpoon Charge
composer musicbox
about    High-energy 158 BPM twin-lead gallop in E minor, inspired by Iron Maiden's The Trooper. Intensity 1 adds upper bass clank, fiddle and war-bell; 2 adds the Belfry choir.
tempo    158
beats    4
steps    4        # 16 sixteenth-note steps per bar: X.xx gallop on every beat
swing    0
reverb   0.24
key      E minor

# Twin Marshall-voiced sawtooth leads panned left and right, rhythm guitar chug, brass stabs, and Steve Harris gallop bass
voice lead1   saw       vol=0.78 pan=-0.52 bright=1.1  att=0.005 rel=0.07 rev=0.25
voice lead2   saw       vol=0.72 pan=0.52  bright=1.25 att=0.005 rel=0.07 rev=0.25
voice chug    guitar    vol=0.72 pan=0     bright=1.6  center=G3 gate=0.58 rev=0.12
voice stab    brass     vol=0.56 pan=0.08  bright=1.5  center=B3 att=0.015 rel=0.1 gate=0.75 rev=0.22
voice gallop  synbass   vol=0.88 pan=0     bright=1.45 att=0.002 rel=0.05 gate=0.72 rev=0.05
# Drum kit: one voice per drum
voice kick    kick      vol=0.95
voice snare   snare     vol=0.92 pan=-0.05 rev=0.22
voice hat     hat       vol=0.44 pan=-0.28
voice ohat    ohat      vol=0.42 pan=-0.28
voice ride    ride      vol=0.36 pan=0.32
voice crash   crash     vol=0.56 pan=-0.35
voice tomh    tomhi     vol=0.72 pan=-0.25
voice tomm    tommid    vol=0.74 pan=0.05
voice toml    tomlo     vol=0.76 pan=0.3
# Depth layers: 1 = string clank, fiddle & war-bell; 2 = epic choir
voice clank   upright   vol=0.54 pan=0.08  bright=2.0  gate=0.65 rev=0.08 layer=1
voice fiddle  fiddle    vol=0.58 pan=-0.22 bright=1.2  rev=0.28 layer=1
voice toll    bell      vol=0.4  pan=-0.45 rev=0.55 layer=1
voice choir   choir     vol=0.34 center=B3 att=0.22 rel=0.8 layer=2

# Cabinet-style mid focus on the twin leads, clank on the bass, and clean low end on kick and toms
eq lead1  highpass=200 peak=1.35k,+4.5,1.6 peak=2.7k,+2.5,1.5 lowpass=4.8k
eq lead2  highpass=220 peak=1.6k,+4.5,1.6  peak=3.1k,+2.5,1.5 lowpass=5k
eq chug   highpass=130 peak=950,+3,1.2
eq gallop peak=80,-3,1.5 peak=1.1k,+4,1.8
eq clank  highpass=180 peak=1.4k,+3,1.5
eq kick   peak=62,+2,1.4 peak=220,-3,1.5
eq ride   highpass=2.5k
eq tomm   peak=132,-3,1.4
eq toml   peak=92,-5,1.4
eq mix    highshelf=8k,+1.5

