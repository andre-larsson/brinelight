title    Held Water
composer musicbox
about    Fights in Dark Water, where the sea has stood still for a hundred years. Intensity 1 adds the cave drone, the far bell and skittering glints; 2 adds the drowned choir.
tempo    96
beats    4
steps    4        # 16 steps a bar: still cave water creeps in 4/4, apart from the Shallows' 6/8 waves
swing    0.08
reverb   0.45
key      A minor

bed   sea     sea       vol=0.2  swell=12
bed   deep    drone     vol=0.34 note=A1 layer=1

voice clar    clarinet  vol=0.82 pan=-0.25 rev=0.42
voice bassoon bassoon   vol=0.72 pan=0.22  rev=0.4
voice pizz    pizz      vol=0.58 pan=0.35  rev=0.3
voice glint   vibes     vol=0.46 pan=-0.38 center=E4 gate=0.65 rev=0.5
voice pad     strings   vol=0.28 pan=-0.1  center=C4 att=0.8 rel=2.0
voice bass    fretless  vol=0.72 glide=0.09
voice snap    rim       vol=0.48 pan=-0.28
voice conga   conga     vol=0.5  pan=0.25
voice tom     tomlo     vol=0.52 pan=0.18
voice pluck   celesta   vol=0.36 pan=0.45  center=A5 chance=0.7 jitter=0.06 rev=0.6 layer=1
voice shaker  shaker    vol=0.28 pan=-0.35 chance=0.85 layer=1
voice toll    bell      vol=0.38 pan=-0.5  rev=0.7 layer=1
voice choir   choir     vol=0.26 center=A3 att=1.2 rel=2.8 layer=2

eq mix   highshelf=8k,+2
eq tom   peak=95,-6,1.4
eq conga peak=130,-3,1.2

# a snap in the dark, and something heavy sliding off the ledge
pattern m_in
harmony | Am | Bbmaj7 E7 |
bass    | A1:6 .:2 E2:4 ~A1:4 | Bb1:6 F2:2 E2:4 B1:4 |
pizz    | A2:2 E3:2 A3:2 .:2 .:4 E3:2 A3:2 | Bb2:2 F3:2 Bb3:2 .:2 E2:2 B2:2 G#3:2 B3:2 |
glint   | .:4 [*]:4 .:8 | .:4 [*]:4 .:4 [*]!:4 |
snap    | X... .... ..x. .... | .... X... .... x.X. |
tom     | _ | .... .... X..x ..XX |
pluck   | .:8 {A5 C6 E6}:8 | _ |

# stalking under black water: fretless slides, offbeat vibes and chitin snaps
pattern m1
harmony | Am | Bbmaj7 | Am | Fmaj7 | Am | Bbmaj7 | Dm7 | E7 |
bass    | A1:6 E2:2 A1:4 ~E2:4 | Bb1:6 F2:2 Bb1:4 ~F2:4 | A1:6 E2:2 A1:4 C2:4 | F1:6 C2:2 F1:4 ~E2:4 |
bass    | A1:6 E2:2 A1:4 ~E2:4 | Bb1:6 F2:2 D2:4 Bb1:4 | D2:6 A1:2 D2:4 F2:4 | E2:6 B1:2 E2:4 G#1:4 |
pizz    | A2:2 .:2 E3:2 A3:2 .:2 C4:2 B3:2 E3:2 | Bb2:2 .:2 F3:2 Bb3:2 .:2 D4:2 A3:2 F3:2 | A2:2 .:2 E3:2 A3:2 .:2 C4:2 E4:2 A3:2 | F2:2 .:2 C3:2 A3:2 .:2 E4:2 C4:2 A3:2 |
pizz    | A2:2 .:2 E3:2 A3:2 .:2 C4:2 B3:2 E3:2 | Bb2:2 .:2 F3:2 Bb3:2 .:2 D4:2 A3:2 F3:2 | D3:2 .:2 A3:2 C4:2 .:2 F4:2 D4:2 A3:2 | E2:2 .:2 B2:2 G#3:2 .:2 D4:2 B3:2 G#3:2 |
glint   | .:2 [*]?:2 .:6 [*]:2 .:4 | % | % | % | % | % | % | % |
snap    | .... X... ..o. ..x. | % | % | % | % | % | % | .... X..x .... X.x. |
conga   | x..o ..x. o.x. ..o. | % | % | % | % | % | % | x..o ..x. x.x. xXX. |
shaker  | x.o. x.ox o.x. x.oo | % | % | % | % | % | % | % |
pluck   | .:6 {A5 C6 E6 .}:6 .:4 | .:10 {A5 D6 F6 .}:6 | .:6 {A5 C6 E6 .}:6 .:4 | .:10 {A5 C6 E6 G5 .}:6 |
pluck   | .:6 {A5 C6 E6 .}:6 .:4 | .:10 {A5 D6 F6 .}:6 | .:6 {A5 C6 D6 F6 .}:6 .:4 | _ |
toll    | A3:16 | _ | _ | _ | A3:16 | _ | _ | _ |
choir   | [*]?:16 | % | % | % | % | % | % | % |

# the keeper's rising A-B-C-E darkened to A-Bb-C-E, answered by the bassoon
pattern m2 from m1
harmony | Am | Bbmaj7 | Gm7 | A7 | Dm | Bbmaj7 | Bm7b5 | E7 |
bass    | A1:6 E2:2 A1:4 ~E2:4 | Bb1:6 F2:2 Bb1:4 F2:4 | G1:6 D2:2 G1:4 Bb1:4 | A1:6 E2:2 A1:4 C#2:4 |
bass    | D2:6 A1:2 D2:4 F2:4 | Bb1:6 F2:2 Bb1:4 D2:4 | B1:6 F2:2 B1:4 D2:4 | E2:6 B1:2 E2:4 G#1:4 |
pizz    | A2:2 .:2 E3:2 A3:2 .:2 C4:2 E4:2 A3:2 | Bb2:2 .:2 F3:2 Bb3:2 .:2 D4:2 A3:2 F3:2 | G2:2 .:2 D3:2 G3:2 .:2 Bb3:2 D4:2 G3:2 | A2:2 .:2 E3:2 G3:2 .:2 C#4:2 A3:2 E3:2 |
pizz    | D3:2 .:2 A3:2 D4:2 .:2 F4:2 D4:2 A3:2 | Bb2:2 .:2 F3:2 Bb3:2 .:2 D4:2 A3:2 F3:2 | B2:2 .:2 F3:2 A3:2 .:2 D4:2 B3:2 F3:2 | E2:2 .:2 B2:2 G#3:2 .:2 D4:2 B3:2 G#3:2 |
clar    | A4:6 Bb4:2 C5:4 E5:4 | F5:6 D5:2 A4:8 | G4:6 A4:2 Bb4:4 D5:4 | C#5:6 Bb4:2 A4:6 .:2 |
clar    | D5:6 E5:2 F5:4 A5:4 | A5:6 F5:2 D5:8 | F5:4 D5:4 B4:4 A4:4 | G#4:10 B4:2 E4:4 |
bassoon | _ | .:8 D3:4 F3:4 | G3:8 .:8 | .:8 E3:4 G3:4 |
bassoon | F3:8 .:8 | .:8 Bb2:4 D3:4 | D3:8 F3:8 | E3:12 .:4 |
pad     | [*]?:16 | % | % | % | % | % | % | % |
pluck   | .:6 {A5 C6 E6 .}:6 .:4 | .:10 {A5 D6 F6 .}:6 | .:6 {G5 Bb5 D6 F6 .}:6 .:4 | _ |
pluck   | .:6 {A5 D6 F6 .}:6 .:4 | .:10 {A5 D6 F6 .}:6 | .:6 {chord}:6 .:4 | _ |
toll    | A3:16 | _ | _ | _ | D4:16 | _ | _ | _ |

# rising out of the murk: low toms and reeds climbing against the bass
pattern m3
harmony | Fmaj7 | E7 | Am | C/G | Fmaj7 | Dm7 | Bm7b5 | E7 |
bass    | F1:6 C2:2 F1:4 C2:4 | E2:6 B1:2 E2:4 G#1:4 | A1:6 E2:2 A1:4 E2:4 | G1:6 C2:2 G1:4 E2:4 |
bass    | F1:6 C2:2 F1:4 A1:4 | D2:6 A1:2 D2:4 F2:4 | B1:6 F2:2 B1:4 D2:4 | E2:4 B1:4 E2:4 G#1:4 |
pizz    | F2:2 C3:2 A3:2 C4:2 .:2 A3:2 C3:2 F2:2 | E2:2 B2:2 G#3:2 B3:2 .:2 G#3:2 B2:2 E2:2 | A2:2 E3:2 A3:2 C4:2 .:2 A3:2 E3:2 A2:2 | G2:2 C3:2 E3:2 C4:2 .:2 G3:2 E3:2 C3:2 |
pizz    | F2:2 C3:2 A3:2 C4:2 .:2 A3:2 C3:2 F2:2 | D3:2 A3:2 C4:2 F4:2 .:2 D4:2 A3:2 D3:2 | B2:2 F3:2 A3:2 D4:2 .:2 B3:2 F3:2 B2:2 | E2:2 B2:2 G#3:2 D4:2 E4!:4 .:4 |
clar    | C5:6 B4:2 A4:4 E5:4 | D5:6 B4:2 G#4:8 | A4:6 B4:2 C5:4 E5:4 | G5:6 E5:2 C5:8 |
clar    | A5:6 G5:2 F5:4 C5:4 | F5:6 E5:2 D5:4 A4:4 | D5:4 B4:4 F4:4 A4:4 | G#4:8 B4:4 E5:4 |
bassoon | A3:8 E3:8 | G#3:8 E3:8 | C4:8 A3:8 | E3:8 G3:8 |
bassoon | C4:8 A3:8 | A3:8 F3:8 | F3:8 D3:8 | E3:8 G#3:4 B3:4 |
glint   | [*]!:4 .:4 [*]:4 .:4 | % | % | % | % | % | % | [*]!:4 .:2 [*]:2 .:4 [*]!:4 |
pad     | [*]:16 | % | % | % | % | % | % | % |
snap    | .... X... ..x. X... | % | % | % | % | % | % | .... X..x ..X. X.X. |
conga   | x..x ..x. o.x. ..x. | % | % | % | % | % | % | x.x. x.x. X.X. XXXX |
tom     | X... .... .... ..x. | X... .... ..x. .... | X... .... .... ..x. | X... .... ..x. ..x. |
tom     | X... .... .... ..x. | X... .... ..x. .... | X... ..x. X... ..x. | X..x X..x X.x. X.X. |
shaker  | x.o. x.ox x.o. x.ox | % | % | % | % | % | % | % |
pluck   | {A5 C6 E6}:4 .:12 | _ | {A5 C6 E6}:4 .:12 | {G5 C6 E6}:4 .:12 |
pluck   | {A5 C6 E6}:4 .:12 | {A5 C6 D6 F6}:4 .:12 | _ | _ |
toll    | A3:16 | _ | A3:16 | _ | C4:16 | _ | _ | _ |
choir   | [*]:16 | % | % | % | % | % | % | % |

# the bassoon leads alone under the glints before the clarinet climbs back in
pattern m3b from m3
clar    | _ | _ | _ | _ |
clar    | A5:6 G5:2 F5:4 C5:4 | F5:6 E5:2 D5:4 A4:4 | D5:4 B4:4 F4:4 A4:4 | G#4:8 B4:4 E5:4 |
bassoon | A3:6 G3:2 F3:4 C4:4 | B3:6 G#3:2 E3:8 | E3:6 G3:2 A3:4 C4:4 | C4:6 G3:2 E3:8 |
bassoon | C4:8 A3:8 | A3:8 F3:8 | F3:8 D3:8 | E3:8 G#3:4 B3:4 |

# sunk out of reach: only the bass sliding in the dark and a claw cocking
pattern m4
harmony | Am | Bbmaj7 | Bm7b5 | Esus4 E7 |
bass    | A1:8 ~E2:8 | Bb1:8 ~F1:8 | B1:8 D2:8 | E2:8 B1:4 G#1:4 |
pizz    | A2:4 .:4 E3:4 .:4 | Bb2:4 .:4 F3:4 .:4 | B2:4 .:4 F3:4 .:4 | E2:4 .:4 G#3:4 .:4 |
glint   | .:4 [*]?:4 .:8 | % | % | .:4 [*]?:4 .:4 [*]:4 |
pad     | [*]?:16 | % | % | % |
snap    | .... X... .... .... | .... .... ..X. .... | .... X... .... ..o. | .... X... ..x. X... |
pluck   | .:8 {A5 C6 E6 .}:8 | .:8 {A5 D6 F6 .}:8 | _ | _ |
toll    | A3:16 | _ | _ | _ |
choir   | [*]?:16 | % | % | % |

cue murk
play m_in
loop m1 m2 {m3 m3b} m4
beds sea deep
