title    Brinelight — Missing Cues Suite
composer musicbox
about    Five new cues for Brinelight: Sheltered Cove (cove), Fog & Toll Bells (fog), Dark Water Fights (murk), The Dark Watch (watch), and Home with Your Haul (haul). Intensity 0 is the Shallows, 1 Dark Water, 2 the Belfry.
tempo    62
beats    3
steps    2
reverb   0.46
key      A minor

# Continuous beds matching music/brinelight.scrim
bed   sea     sea       vol=0.7  swell=9
bed   wind    wind      vol=0.22 pan=-0.3
bed   deep    drone     vol=0.32 note=A1 layer=1

# Shared voices from music/brinelight.scrim, plus cue-specific colours
voice flute   flute     vol=0.8  pan=-0.25 rev=0.45
voice clar    clarinet  vol=0.72 pan=0.26  rev=0.4
voice bassoon bassoon   vol=0.72 pan=0.22  rev=0.4
voice guitar  guitar    vol=0.54 pan=-0.22 center=C4 arp=updown span=1 rev=0.45
voice strum   guitar    vol=0.48 pan=0.3   center=C4 gate=0.5 rev=0.3
voice squeeze accordion vol=0.46 pan=-0.28 center=E4 att=0.06 rel=0.4 rev=0.35
voice lyre    harp      vol=0.42 pan=-0.4  center=A3 arp=updown rate=2 span=2 chance=0.85 jitter=0.04 rev=0.5
voice organ   pipe      vol=0.26 pan=-0.1  center=C4 att=1.8 rel=3.5 rev=0.6
voice sigh    voices    vol=0.4  pan=-0.22 att=0.8 rel=2.2 glide=0.22 rev=0.68
voice pad     strings   vol=0.3  pan=-0.1  center=C4 att=1.2 rel=2.5
voice bass    fretless  vol=0.64 glide=0.09
voice walk    upright   vol=0.74
voice pluck   celesta   vol=0.32 pan=0.45  center=A5 chance=0.6 jitter=0.14 rev=0.6
voice spark   glock     vol=0.24 pan=-0.38 chance=0.55 jitter=0.18 rev=0.75
voice glint   vibes     vol=0.44 pan=-0.36 center=E4 gate=0.65 rev=0.5
voice mirror  musicbox  vol=0.54 pan=0.3   rev=0.64
voice pizz    pizz      vol=0.56 pan=0.35  rev=0.3
voice fiddle  fiddle    vol=0.7  pan=-0.32 rev=0.35
voice horn    horn      vol=0.58 pan=0.18  center=D4 att=0.16 rev=0.42
voice bodhran bodhran   vol=0.48 pan=-0.2
voice tom     tomlo     vol=0.52 pan=0.2
voice timp    timpani   vol=0.58
voice knell   bell      vol=0.44 pan=-0.15 rev=0.68
voice gong    gong      vol=0.3  pan=0.2
voice snap    rim       vol=0.46 pan=-0.25
voice tick    rim       vol=0.38 pan=-0.15
voice conga   conga     vol=0.5  pan=0.25
# Depth layers: 1 = Dark Water, 2 = the Belfry
voice mist_vb vibes     vol=0.34 pan=-0.3  center=Eb4 att=0.15 rel=2.0 chance=0.75 rev=0.62 layer=1
voice shaker  shaker    vol=0.25 pan=0.35  chance=0.82 layer=1
voice toll    bell      vol=0.36 pan=-0.5  rev=0.72 layer=1
voice choir   choir     vol=0.26 center=A3 att=1.5 rel=3.0 layer=2

eq organ   lowpass=950
eq mix     highshelf=8k,+2
eq bodhran peak=80,-6,1.4
eq tom     peak=95,-6,1.4
eq timp    peak=75,-4,1.5
eq conga   peak=130,-3,1.2

