title    What Waits in the Fog
composer musicbox
about    Shrines, wrecks, the drowned lamplighter and the toll bells: suspended 5/4 in C minor over a sunken pipe organ, isolated chimes and a wordless voice in the mist.
tempo    58
beats    5
steps    2        # 5/4 in eighth notes (6+4), 10 steps a bar: asymmetric and unhurried
reverb   0.62
key      C minor

bed   sea     sea       vol=0.35 swell=12
bed   wind    wind      vol=0.28 pan=-0.35

voice organ   pipe      vol=0.26 pan=-0.1  center=C4 att=1.8 rel=3.5 rev=0.6
voice sigh    voices    vol=0.4  pan=-0.22 att=0.8 rel=2.2 glide=0.22 rev=0.68
voice chime   musicbox  vol=0.5  pan=0.3   chance=0.85 jitter=0.07 rev=0.68
voice spark   glock     vol=0.24 pan=-0.38 chance=0.55 jitter=0.18 rev=0.75
voice bass    fretless  vol=0.5  glide=0.14
voice gong    gong      vol=0.22 pan=0.2   chance=0.6
voice glint   vibes     vol=0.34 pan=-0.3  center=Eb4 att=0.15 rel=2.0 chance=0.75 rev=0.62 layer=1
voice toll    bell      vol=0.34 pan=-0.48 rev=0.75 layer=1
voice choir   choir     vol=0.26 center=C4 att=1.8 rel=3.2 layer=2

eq organ lowpass=950
eq mix   highshelf=8k,+2

# stepping off the stair into cold mist: sunken organ and lone drops in 5/4
pattern fg_in
harmony | Cm | Dbmaj7 | Cm | G7b9 |
organ   | [*]?:10 | % | % | % |
bass    | C2:10 | Db2:10 | C2:10 | G1:10 |
chime   | .:4 G5?:4 .:2 | .:6 Ab5??:4 | .:4 Eb5?:4 .:2 | .:6 D5??:4 |

# stone hands held out: isolated brinelight drops with long silences between them
pattern fg1
harmony | Cm | % | Dbmaj7 | % | Fm7 | Dbmaj7 | Dm7b5 | G7b9 |
organ   | [*]?:10 | % | % | % | % | % | % | % |
bass    | C2:10 | = | Db2:10 | = | F1:10 | Db2:10 | D2:10 | G1:10 |
chime   | G5:4 Eb5:2 C5:4 | .:6 {C5 Eb5 G5 Bb5 .}?:4 | Ab5:4 F5:2 C5:4 | .:6 {C5 Db5 F5 Ab5 .}?:4 |
chime   | C6:4 Ab5:2 F5:4 | .:4 Ab5?:6 | Ab5?:4 F5?:2 D5?:4 | .:6 B4??:4 |
spark   | .:2 {C6 Eb6 G6 .}?:8 | _ | .:4 {C6 F6 Ab6 .}?:6 | _ |
spark   | .:2 {C6 Eb6 F6 Ab6 .}?:8 | _ | .:4 {C6 D6 F6 Ab6 .}?:6 | _ |
glint   | .:6 [*]?:4 | _ | .:6 [*]?:4 | _ | .:6 [*]?:4 | _ | .:6 [*]?:4 | _ |
toll    | C4?:10 | _ | _ | _ | _ | _ | _ | G3?:10 |
choir   | [*]?:10 | % | % | % | % | % | % | % |

# sparser still, while you read in the silence
pattern fg1b from fg1
chime   | .:2 {C5 Eb5 G5 .}?:4 .:4 | _ | .:2 {C5 F5 Ab5 .}?:4 .:4 | _ |
chime   | .:4 {F5 Ab5 C6 .}?:6 | _ | {D5 F5 Ab5}?:6 .:4 | _ |

# a wordless voice across the pool, and iron groaning once in the dark
pattern fg2
harmony | Abmaj7 | Fm7 | Cm | Eb/Bb | Dbmaj7 | Dm7b5 | Gsus4 | G7b9 |
organ   | [*]?:10 | % | % | % | [*]:10 | % | [*]?:10 | % |
bass    | Ab1:10 | F1:10 | C2:10 | Bb1:10 | Db2:10 | D2:10 | G1:10 | = |
gong    | X......... | _ | _ | _ | _ | _ | _ | _ |
sigh    | .:2 Eb5:4 ~G5?:4 | F5:6 ~C5?:4 | Eb5:5 ~D5? C5:4 | Bb4:6 .:4 |
sigh    | .:2 C5:4 ~F5?:4 | Ab5?:6 ~F5:4 | D5:6 C5:4 | ~B4:6 .:4 |
chime   | _ | .:6 Ab5??:4 | _ | .:6 G5??:4 | _ | .:6 C6??:4 | _ | _ |
glint   | .:6 [*]?:4 | _ | .:6 [*]?:4 | _ | .:6 [*]:4 | .:6 [*]:4 | _ | _ |
toll    | _ | _ | C4?:10 | _ | Db4?:10 | _ | _ | G3?:10 |
choir   | [*]?:10 | % | % | % | [*]:10 | % | [*]?:10 | % |

# a lower, quieter sigh on another pass
pattern fg2b from fg2
sigh    | .:2 C5:4 ~Eb5?:4 | C5:6 ~Ab4?:4 | G4:6 .:4 | _ |
sigh    | .:2 Ab4:4 ~Db5?:4 | C5:6 ~Ab4:4 | G4:6 C5?:4 | ~B4?:6 .:4 |

# only the sunken organ and high sparks before the mist closes in again
pattern fg3
harmony | Dbmaj7 | % | Dm7b5 | G7b9 |
organ   | [*]?:10 | % | % | % |
bass    | Db2:10 | = | D2:10 | G1:10 |
spark   | .:4 {C6 F6 Ab6 .}?:6 | _ | .:4 {C6 D6 F6 Ab6 .}?:6 | _ |
chime   | C6??:6 F5??:4 | .:10 | Ab5??:6 D5??:4 | G5??:4 B4??:6 |
toll    | _ | _ | _ | G3??:10 |
choir   | [*]?:10 | % | % | % |

cue fog
play fg_in
loop {fg1 fg1b} {fg2 fg2b} fg3
beds sea wind
