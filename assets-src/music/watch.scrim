title    Her Own Bell
composer musicbox
about    The Dark Watch, before Nobody Comes Home: Wren's drowned double ticks the watch glass and rings her own song back upside down. Intensity 1 adds the drone and far bell; 2 adds the Belfry's choir.
tempo    76
beats    2
steps    3        # 6/8, 6 steps a bar: the swing of a hand-bell and the watch glass
reverb   0.5
key      A minor

bed   sea     sea       vol=0.35 swell=10
bed   deep    drone     vol=0.36 note=A1 layer=1

voice mirror  musicbox  vol=0.58 pan=0.3   rev=0.6
voice fiddle  fiddle    vol=0.7  pan=-0.3  rev=0.35
voice knell   bell      vol=0.52 pan=0.18  rev=0.62
voice horn    horn      vol=0.46 pan=0.22  center=D4 att=0.25
voice pizz    pizz      vol=0.56 pan=0.35
voice pad     strings   vol=0.3  pan=-0.1  center=C4 att=0.8 rel=2.2
voice bass    fretless  vol=0.66
voice timp    timpani   vol=0.58
voice tick    rim       vol=0.38 pan=-0.15
voice bodhran bodhran   vol=0.52 pan=-0.2
voice gong    gong      vol=0.38 pan=0.2
voice toll    bell      vol=0.4  pan=-0.5  rev=0.72 layer=1
voice choir   choir     vol=0.3  center=A3 att=1.2 rel=2.8 layer=2

eq mix     highshelf=8k,+2
eq bodhran peak=80,-6,1.4
eq timp    peak=75,-4,1.5

# the watch glass ticks in the dark, and her unlit chime turns Wren's song upside down
pattern w_in
harmony | Am | F/A | Dm/A | E7b9 |
tick    | X.. o.. | % | % | X.. x.x |
bass    | A1:6 | = | A1:6 | E1:6 |
knell   | E4:6 | _ | A3:6 | _ |
mirror  | _ | F5:2 E5 C5:3 | D5:2 C5 A4:3 | B4:3 G#4:3 |
pad     | [*]??:6 | % | [*]?:6 | % |
toll    | A3?:6 | _ | _ | _ |

# Ring Her Bell: instead of rising A-B-C-E, the chime falls E-D-C-A over an A pedal
pattern w1
harmony | Am | F/A | Dm/A | E7b9 | Am | Fmaj7 | Bm7b5 | E7b9 |
tick    | X.. o.. | % | % | % | % | % | % | X.o x.o |
bodhran | X.. x.. | % | % | % | % | % | % | X.x xXx |
bass    | A1:3 E2:3 | A1:3 F2:3 | A1:3 D2:3 | E1:3 B1:3 | A1:3 E2:3 | F1:3 C2:3 | B1:3 F2:3 | E2:3 G#1:3 |
pizz    | A2 E3 A3 E3 C3 E3 | A2 F3 A3 F3 C3 F3 | A2 D3 A3 D3 F3 D3 | E2 B2 G#3 B2 F3 B2 |
pizz    | A2 E3 A3 E3 C3 E3 | F2 C3 A3 C3 E3 C3 | B2 F3 A3 F3 D3 F3 | E2 B2 G#3 D3 F3 G#3 |
mirror  | E5:2 D5 C5:3 | A4:3 C5:3 | F5:2 E5 D5:3 | B4:6 |
mirror  | E5:2 D5 C5:3 | E5:3 C5:3 | D5:2 C5 B4:2 A4 | G#4:3 B4:3 |
knell   | A3:6 | _ | _ | _ | E4:6 | _ | _ | _ |
pad     | [*]?:6 | % | % | % | % | % | % | % |
toll    | A3:6 | _ | _ | _ | A3:6 | _ | _ | _ |
choir   | [*]?:6 | % | % | % | % | % | % | % |

# the duel: Wren's fiddle (left) sings her rising line; her shadow (right) pulls each phrase back down
pattern w2 from w1
harmony | Am | Dm/A | Fmaj7 | E7b9 | Am | Bb | Bm7b5 | E7b9 |
bass    | A1:3 E2:3 | A1:3 D2:3 | F1:3 C2:3 | E1:3 B1:3 | A1:3 E2:3 | Bb1:3 F1:3 | B1:3 F2:3 | E2:3 G#1:3 |
pizz    | A2 E3 A3 E3 C3 E3 | A2 D3 A3 D3 F3 D3 | F2 C3 A3 C3 E3 C3 | E2 B2 G#3 B2 F3 B2 |
pizz    | A2 E3 A3 E3 C3 E3 | Bb2 F3 Bb3 F3 D3 F3 | B2 F3 A3 F3 D3 F3 | E2 B2 G#3 D3 F3 G#3 |
fiddle  | A4:2 B4 C5:2 E5 | F5:3 .:3 | A4:2 B4 C5:2 F5 | E5:3 .:3 |
fiddle  | A4:2 C5 E5:2 A5 | F5:3 D5:3 | F5:2 D5 B4:2 A4 | G#4:6 |
mirror  | _ | F5:2 E5 D5:3 | _ | F5:2 D5 B4:3 |
mirror  | _ | Bb5:2 F5 D5:3 | B5:3 F5:3 | E5:3 G#5:3 |
timp    | A2!:6 | _ | F2:6 | E2!:6 | A2!:6 | Bb2!:6 | B2:6 | E2! E2 E2 E2! E2! E2!! |

# Lights Out: horns, timpani and gong, with fiddle and chime locked in contrary motion
pattern w3
harmony | Dm | E7b9 | Am | Fmaj7 | Dm | Bb | Bm7b5 | E7b9 |
tick    | X.x o.x | % | % | % | % | % | % | Xxx XXX |
bodhran | X.x X.x | % | % | % | % | % | % | Xxx XXX |
bass    | D2:3 A1:3 | E2:3 B1:3 | A1:3 E2:3 | F1:3 C2:3 | D2:3 A1:3 | Bb1:3 F1:3 | B1:3 F2:3 | E2:3 G#1:3 |
pizz    | D3 A3 D4 A3 F3 A3 | E2 B2 G#3 B2 F3 B2 | A2 E3 A3 E3 C3 E3 | F2 C3 A3 C3 E3 C3 |
pizz    | D3 A3 D4 A3 F3 A3 | Bb2 F3 Bb3 F3 D3 F3 | B2 F3 A3 F3 D3 F3 | E2 B2 G#3 D3 F3 G#3 |
horn    | D4:6 | E4:6 | C4:6 | A3:6 | F4:6 | F4:6 | D4:6 | E4!:6 |
fiddle  | D5:2 E5 F5:3 | G#5:3 E5:3 | E5:2 D5 C5:3 | C5:3 A4:3 |
fiddle  | F5:2 G5 A5:3 | F5:3 D5:3 | D5:2 C5 B4:3 | B4:3 G#4:3 |
mirror  | A5:3 F5:3 | B5:3 G#5:3 | A5:2 B5 C6:3 | E5:3 C5:3 |
mirror  | D6:3 A5:3 | Bb5:3 F5:3 | F5:3 D5:3 | E5!:3 G#5!:3 |
knell   | D4:6 | _ | A3:6 | _ | D4:6 | _ | _ | E4!:6 |
timp    | D2!:3 A2:3 | E2!:3 B2:3 | A2!:3 E2:3 | F2!:3 C3:3 | D2!:3 A2:3 | Bb2!:3 F2:3 | B2!:3 F2:3 | E2! E2 E2 E2! E2!! E2!! |
gong    | X..... | _ | _ | _ | X..... | _ | _ | _ |
pad     | [*]:6 | % | % | % | % | % | % | % |
toll    | D4:6 | _ | A3:6 | _ | D4:6 | _ | _ | _ |
choir   | [*]:6 | % | % | % | % | % | % | % |

# Pinch the Wick: the lantern dims to the watch glass and the chime
pattern w4
harmony | Am | F/A | Dm/A | E7b9 |
tick    | X.. o.. | % | % | X.. o.x |
bass    | A1:6 | = | A1:6 | E1:6 |
mirror  | E5?:3 C5?:3 | F5?:3 C5?:3 | D5?:3 A4?:3 | B4?:3 G#4?:3 |
knell   | A3?:6 | _ | _ | _ |
pad     | [*]?:6 | % | % | % |
toll    | A3?:6 | _ | _ | _ |
choir   | [*]?:6 | % | % | % |

cue watch
play w_in
loop w1 w2 w3 w4
beds sea deep
